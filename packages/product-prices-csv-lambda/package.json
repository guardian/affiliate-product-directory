{
	"name": "product-prices-csv-lambda",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" npx jest --detectOpenHandles --config ../../jest.config.js --selectProjects product-prices-csv-lambda",
		"type-check": "tsc --noEmit -p tsconfig.json",
		"prebuild": "rm -rf dist",
		"build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outdir=dist",
		"postbuild": "cd dist && zip -r product-prices-csv-lambda.zip ."
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1141.0",
		"@types/aws-lambda": "^8.10.125",
		"esbuild": "0.28.2"
	}
}
